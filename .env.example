# Shared OpenRouter key used by ALL app users (bundled at build time).
# Copy this file to `.env` and paste your key — `.env` is gitignored.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here
# Multimodal LLM defaults (vision-capable chat + 360 image model).
# Any OpenRouter slug works; chat default auto-routes to a free vision model.
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
